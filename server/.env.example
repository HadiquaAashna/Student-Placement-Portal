PORT=5000
MONGODB_URI=mongodb://localhost:27017/campusconnect
JWT_SECRET=supersecretplacementportaltokenkey12345!

# Frontend URL (used for post-login redirects from IBM App ID)
FRONTEND_URL=http://localhost:4321

# Backend base URL (used to build the App ID redirect/callback URI)
BACKEND_URL=https://student-placement-portal-uzqi.onrender.com

# IBM App ID OAuth callback URI (must be registered in App ID dashboard)
APP_ID_REDIRECT_URI=https://student-placement-portal-uzqi.onrender.com/api/auth/appid/callback

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# IBM App ID Configuration
IBM_APP_ID_TENANT_ID=your_ibm_appid_tenant_id
IBM_APP_ID_CLIENT_ID=your_ibm_appid_client_id
IBM_APP_ID_SECRET=your_ibm_appid_secret
IBM_APP_ID_OAUTH_SERVER_URL=https://us-south.appid.cloud.ibm.com/oauth/v4/your_tenant_id

# IBM Watson Assistant Configuration
IBM_WATSON_ASSISTANT_APIKEY=your_ibm_watson_assistant_apikey
IBM_WATSON_ASSISTANT_SERVICE_URL=https://api.us-south.assistant.watson.cloud.ibm.com/instances/your_instance_id
IBM_WATSON_ASSISTANT_ID=your_ibm_watson_assistant_id
